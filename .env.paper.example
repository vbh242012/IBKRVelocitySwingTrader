# Copy this to .env.paper.local and fill only local machine values there.
# Do not commit .env.paper.local. It is ignored by .gitignore.

VELOCITY_TRADING_MODE=paper
VELOCITY_BASE_DIR=/home/harika/MyLearning/AI/IBKRVelocitySwingTrader/runtime/paper
VELOCITY_IB_HOST=127.0.0.1
VELOCITY_IB_PORT=4002
VELOCITY_IB_CLIENT_ID=1

# Stock entries require real-time data. VIX can use delayed data as a regime filter.
VELOCITY_MARKET_DATA_TYPE=1
VELOCITY_VIX_MARKET_DATA_TYPE=3
# Candidate ranking model. The default profile is RS-first MA trend timing.
# Bollinger and PSAR remain standalone research profiles unless enabled.
VELOCITY_STRATEGY_PROFILE=indicator_swing
VELOCITY_SCORING_MODEL=indicator_swing

# Application scanner candidates. "hybrid" means IBKR scanner hits plus a
# rotating full common-stock universe batch. Final buys still require local
# screener/profile rules to pass.
VELOCITY_APP_SCANNER_SOURCE=hybrid
VELOCITY_APP_SCANNER_BATCH_SIZE=25
VELOCITY_APP_SCANNER_MAX_SYMBOLS=0
# Optional deterministic universe file; one symbol per line or a CSV with symbol/ticker column.
# VELOCITY_APP_SCANNER_UNIVERSE_FILE=runtime/paper/symbol_universe.csv
VELOCITY_APP_PREFILTER_ENABLED=1
VELOCITY_APP_PREFILTER_START_TIME=06:30
VELOCITY_APP_PREFILTER_HISTORY_SLEEP_SEC=0.05
VELOCITY_APP_PREFILTER_PROGRESS_EVERY=100
VELOCITY_APP_PREFILTER_STOP_AT_ENTRY_START=1

# Analyst ratings are a bounded score adjustment, not a standalone buy signal.
# Live/paper use local CSV first, then Finnhub if a key is configured, then Yahoo/yfinance.
# Backtests use only dated local CSV snapshots to avoid look-ahead bias.
VELOCITY_ANALYST_RATINGS_ENABLED=1
VELOCITY_ANALYST_RATINGS_FREE_SOURCE=yahoo
# VELOCITY_FINNHUB_API_KEY=
# VELOCITY_ANALYST_RATINGS_FILE=runtime/paper/analyst_ratings.csv
VELOCITY_ANALYST_RATING_SCORE_WEIGHT=8
VELOCITY_ANALYST_RATING_SELL_THRESHOLD=-0.35

# HMDS/VIX protection: warm historical data after connect/reconnect and back off
# if IBKR historical data keeps timing out.
VELOCITY_HISTORICAL_DATA_WARMUP_ENABLED=1
VELOCITY_HISTORICAL_DATA_TIMEOUT_SEC=25
VELOCITY_VIX_CACHE_TTL_SEC=300
VELOCITY_VIX_FAILURE_COOLDOWN_BASE_SEC=300
VELOCITY_VIX_FAILURE_COOLDOWN_MAX_SEC=600

# Keep the bot paper-only. Never set VELOCITY_LIVE_TRADING_ACK here.

# Optional alert webhook. Strongly recommended before multi-day unattended runs.
# VELOCITY_ALERT_WEBHOOK_URL=

# Optional dashboard token if binding dashboard beyond localhost.
# VELOCITY_DASHBOARD_TOKEN=
VELOCITY_DASHBOARD_HOST=127.0.0.1
VELOCITY_DASHBOARD_PORT=8080

# Trader process supervision.
# Auto-restart handles clean Python exits. The watchdog handles the nastier
# failure mode where Python stays alive but dashboard_data.json stops updating.
VELOCITY_TRADER_AUTO_RESTART=1
VELOCITY_TRADER_RESTART_DELAY_SEC=30
VELOCITY_TRADER_WATCHDOG_ENABLED=1
VELOCITY_TRADER_STALE_SEC=600
VELOCITY_TRADER_WATCHDOG_INTERVAL_SEC=15
VELOCITY_TRADER_WATCHDOG_STARTUP_GRACE_SEC=900

# IBC / IB Gateway supervision.
# Install IBC separately, configure IBC's own config.ini with paper credentials,
# then point this command at IBC's gateway startup script.
VELOCITY_IB_GATEWAY_AUTO_START=1
VELOCITY_IB_GATEWAY_START_CMD="/home/harika/ibc/start-paper-gateway.sh"
VELOCITY_IB_GATEWAY_START_TIMEOUT_SEC=240
VELOCITY_IB_GATEWAY_START_POLL_SEC=2
VELOCITY_IB_GATEWAY_STOP_ON_EXIT=0
VELOCITY_IB_GATEWAY_LOG_FILE=runtime/paper/logs/ib_gateway_launcher.log
