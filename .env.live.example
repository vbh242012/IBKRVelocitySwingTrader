# Copy this to .env.live.local only when you are ready to run live.
# Do not commit .env.live.local. It is ignored by .gitignore.

VELOCITY_TRADING_MODE=live
VELOCITY_BASE_DIR=/home/harika/MyLearning/AI/IBKRVelocitySwingTrader/runtime/live
VELOCITY_IB_HOST=127.0.0.1
VELOCITY_IB_PORT=4001
VELOCITY_IB_CLIENT_ID=1

# Stock entries require real-time data. VIX can use delayed data as a regime filter.
VELOCITY_MARKET_DATA_TYPE=1
VELOCITY_VIX_MARKET_DATA_TYPE=3
# HMDS/VIX protection: warm historical data after connect/reconnect and back off
# if IBKR historical data keeps timing out.
VELOCITY_HISTORICAL_DATA_WARMUP_ENABLED=1
VELOCITY_HISTORICAL_DATA_TIMEOUT_SEC=25
VELOCITY_VIX_CACHE_TTL_SEC=300
VELOCITY_VIX_FAILURE_COOLDOWN_BASE_SEC=300
VELOCITY_VIX_FAILURE_COOLDOWN_MAX_SEC=600

# Live trading is intentionally gated by the application and by start_trader.sh.
# Uncomment only after paper validation and after confirming IB Gateway is
# logged into the live account on port 4001.
# VELOCITY_LIVE_TRADING_ACK=I_UNDERSTAND_LIVE_RISK

# Strongly recommended before live trading.
# VELOCITY_ALERT_WEBHOOK_URL=

# Optional dashboard token if binding dashboard beyond localhost.
# VELOCITY_DASHBOARD_TOKEN=
VELOCITY_DASHBOARD_HOST=127.0.0.1
VELOCITY_DASHBOARD_PORT=8081

# Trader process supervision. This restarts auto_trader.py if Python exits.
VELOCITY_TRADER_AUTO_RESTART=1
VELOCITY_TRADER_RESTART_DELAY_SEC=30

# IBC / IB Gateway supervision.
# Configure /home/harika/ibc/config.live.ini with live credentials locally.
VELOCITY_IB_GATEWAY_AUTO_START=1
VELOCITY_IB_GATEWAY_START_CMD="/home/harika/ibc/start-live-gateway.sh"
VELOCITY_IB_GATEWAY_START_TIMEOUT_SEC=240
VELOCITY_IB_GATEWAY_START_POLL_SEC=2
VELOCITY_IB_GATEWAY_STOP_ON_EXIT=0
VELOCITY_IB_GATEWAY_LOG_FILE=runtime/live/logs/ib_gateway_launcher.log
