# Copy this to .env.paper.local and fill only local machine values there.
# Do not commit .env.paper.local. It is ignored by .gitignore.

VELOCITY_TRADING_MODE=paper
VELOCITY_IB_HOST=127.0.0.1
VELOCITY_IB_PORT=4002
VELOCITY_IB_CLIENT_ID=1

# Stock entries require real-time data. VIX can use delayed data as a regime filter.
VELOCITY_MARKET_DATA_TYPE=1
VELOCITY_VIX_MARKET_DATA_TYPE=3

# Keep the bot paper-only. Never set VELOCITY_LIVE_TRADING_ACK here.

# Optional alert webhook. Strongly recommended before multi-day unattended runs.
# VELOCITY_ALERT_WEBHOOK_URL=

# Optional dashboard token if binding dashboard beyond localhost.
# VELOCITY_DASHBOARD_TOKEN=

# IBC / IB Gateway supervision.
# Install IBC separately, configure IBC's own config.ini with paper credentials,
# then point this command at IBC's gateway startup script.
VELOCITY_IB_GATEWAY_AUTO_START=1
VELOCITY_IB_GATEWAY_START_CMD="/home/harika/ibc/gatewaystart.sh -inline"
VELOCITY_IB_GATEWAY_START_TIMEOUT_SEC=240
VELOCITY_IB_GATEWAY_START_POLL_SEC=2
VELOCITY_IB_GATEWAY_STOP_ON_EXIT=0
VELOCITY_IB_GATEWAY_LOG_FILE=logs/ib_gateway_launcher.log
